<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- COLUMN 1 (left): photo / avatar, fixed 128dp square.
             ivPhoto and tvInitials are stacked in a FrameLayout so only
             one is ever visible at a time and neither affects the layout
             of the other two columns. -->
        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp">

            <ImageView
                android:id="@+id/ivPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="@string/contact_photo" />

            <TextView
                android:id="@+id/tvInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="36sp"
                android:textColor="@color/avatar_text"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/bg_avatar"
                android:visibility="visible" />

        </FrameLayout>

        <!-- COLUMN 2 (center): contact name — left-aligned, wraps,
             takes up all remaining space between photo and icons. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="start"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="4"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvAddLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/tap_to_add"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:gravity="start"
                android:visibility="gone" />

        </FrameLayout>

        <!-- COLUMN 3 (right): action icons, stacked vertically —
             Phone on top, WhatsApp below. Fixed width, never shrinks. -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallPhone"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="@color/accent"
                app:icon="@drawable/ic_call"
                app:iconTint="@color/white"
                app:iconSize="24dp"
                app:cornerRadius="16dp"
                android:visibility="gone"
                android:contentDescription="@string/cd_phone_icon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallWhatsapp"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:backgroundTint="@color/whatsapp_green"
                app:icon="@drawable/ic_whatsapp"
                app:iconTint="@color/white"
                app:iconSize="24dp"
                app:cornerRadius="16dp"
                android:visibility="gone"
                android:contentDescription="@string/cd_whatsapp_icon" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
